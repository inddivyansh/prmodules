# Instagram Credentials
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Hashtags to monitor
POSITIVE_HASHTAGS=indianarmy,indianarmedforces,southerncommand,adgpi,jaihind
NEGATIVE_HASHTAGS=indianarmycrimes,armyatrocities,kashmirviolence,humanrightsviolation

# Keywords to search (high-engagement search queries)
SEARCH_KEYWORDS=indian army viral,kashmir encounter,agniveer protest,indian army fake,army brutality,false encounter,indian army news,ladakh border army

# AI Model
OLLAMA_MODEL=llama3.2

# Bot Settings
MAX_POSTS_TO_SCAN_PER_SOURCE=20
MAX_COMMENTS_PER_SESSION=30
DELAY_BETWEEN_COMMENTS_SECONDS=68
MAX_COMMENT_LENGTH=220
COMMENT_PREFIX=
DETECTION_STRATEGY=trending_first
HEADLESS=false
MAX_POST_AGE_DAYS=14
ENABLE_TRENDING_NEWS=true
SHUFFLE_SOURCES=true
